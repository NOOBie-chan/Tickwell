{
  "name": "tickwell",
  "productName": "Tickwell",
  "version": "1.0.0",
  "description": "Tickwell checklists",
  "author": "Your Name",
  "main": "main.js",
  "scripts": {
    "prep": "node prep.js",
    "start": "node prep.js && electron .",
    "dist": "node prep.js && electron-builder --win"
  },
  "build": {
    "appId": "com.yourname.tickwell",
    "productName": "Tickwell",
    "files": [
      "main.js",
      "app-www/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}